# Single source of truth for the GraalVM CE version built into the image.
#
# Read by the Makefile (`include`) and by .github/workflows/publish.yml (`source`), so keep
# this plain KEY=value: no spaces around `=`, no quotes, no `export`.
#
# GRAALVM_VERSION     - release/tag version (the graal-<version> tag on graalvm-ce-builds)
# GRAALVM_JDK_VERSION - JDK version embedded in the download file name; since the 25i3
#                       release line this can differ from the release/tag version
GRAALVM_VERSION=25.5.5.0.3
GRAALVM_JDK_VERSION=25i5-25.0.5.0.3
